; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NFTL_Test_1.1"
run/main_scene="res://Map/base.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ConsoleDataManager="*res://addons/simply-console/singletons/console_data_manager.gd"
Global="*res://Globals/global.gd"
Start4="*res://Generation/start4.gd"
Starmap="*res://Map/starmap.gd"
Resources="*res://Civilization Info/Resources/resources.gd"
DiscordRPCLoader="*res://addons/discord-rpc-gd/nodes/discord_autoload.gd"

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/SimpleTODO/plugin.cfg", "res://addons/discord-rpc-gd/plugin.cfg", "res://addons/godot_style/plugin.cfg", "res://addons/simply-console/plugin.cfg")

[filesystem]

import/blender/enabled=false

